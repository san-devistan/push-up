{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm run sync:theme && portless run expo start",
    "start": "pnpm run dev",
    "android": "pnpm run sync:theme && expo start --android",
    "check:counter": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-counter.mts",
    "check:gamification": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-gamification.mts",
    "check:goal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-goal.mts",
    "ios": "pnpm run sync:theme && expo start --ios",
    "lint": "cd ../.. && oxlint apps/mobile",
    "sync:theme": "node ../../scripts/sync-design-system.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "1.6.15",
