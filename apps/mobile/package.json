{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ../../scripts/sync-design-system.mjs && portless run expo start",
    "start": "node ../../scripts/sync-design-system.mjs && portless run expo start",
    "android": "node ../../scripts/sync-design-system.mjs && expo start --android",
    "check:activity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-activity-window.mts",
    "check:counter": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-counter.mts",
    "check:gamification": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-gamification.mts",
    "check:goal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types features/workout/_lib/check-goal.mts",
    "check:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types lib/check-i18n.mts",
    "ios": "node ../../scripts/sync-design-system.mjs && expo start --ios",
    "lint": "cd ../.. && oxlint apps/mobile",
    "sync:theme": "node ../../scripts/sync-design-system.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "1.6.15",
    "@better-auth/expo": "1.6.15",
    "@bible-strong/avatar-react": "0.1.0",
    "@convex-dev/better-auth": "0.12.5",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~57.0.11",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@workspace/backend": "workspace:*",
    "better-auth": "1.6.15",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "expo": "57.0.14",
    "expo-apple-authentication": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "~57.0.6",
    "expo-media-library": "57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "57.0.13",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "panelui-native": "0.75.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.36.5",
    "react-native-nitro-pose-exercises": "1.1.19",
    "react-native-numeric-text": "0.2.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-worklets": "5.0.11",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "uniwind": "1.11.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "babel-preset-expo": "^57.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@expo/ui",
        "expo",
        "expo-build-properties",
        "expo-constants",
        "expo-dev-client",
        "expo-linking",
        "expo-notifications",
        "expo-router",
        "expo-sharing"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image"
        ]
      }
    }
  },
  "portless": {
    "name": "mobile.pushup"
  }
}
