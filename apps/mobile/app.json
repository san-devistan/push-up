{
  "expo": {
    "name": "pumpr.",
    "slug": "pumpr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pumpr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "GBPRFMH5S5",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": ["group.com.rukahiga.pumpr"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "pumpr. uses the camera to count repetitions locally on your device."
      },
      "bundleIdentifier": "com.rukahiga.pumpr"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.rukahiga.pumpr"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow pumpr. to use device motion to help position your phone."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow pumpr. to access your photo library to save performance images.",
          "savePhotosPermission": "Allow pumpr. to save transparent performance PNGs.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "react-native-share",
        {
          "ios": ["instagram", "instagram-stories"],
          "android": ["com.instagram.android"]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@bacons/apple-targets",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.rukahiga.pumpr.daily-app-blocker-monitor",
                  "targetName": "DailyAppBlockerMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.rukahiga.pumpr"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "18abc9c0-a8ce-4f0a-89de-fe63bb25cfaa"
      }
    },
    "owner": "rukahiga"
  }
}
