# What runs on the mirror. Sourced by scripts/dev/vps.
#
# The address of the mirror is deliberately not here: this repo is public, and a
# host plus a login is all a scanner needs. Put it in scripts/dev/vps.env.local,
# which git ignores:
#
#   VPS_HOST=user@host
#   VPS_PATH=/srv/push-up

# apps/mobile/ios holds ~4 GB of Pods, static archives and dSYMs — Xcode output that
# only means anything on the Mac. Sending it would dominate every mirror.
VPS_EXCLUDES="ios/ android/ Pods/ .expo/ .turbo/ .asc/ screenshots/ *.ipa *.app"

# corepack reads packageManager from package.json, so the pnpm version follows the repo.
# Reinstalling is by far the slowest step, so it only runs when the lockfile actually moved.
VPS_INSTALL='corepack enable >/dev/null 2>&1 || true; if [ ! -d node_modules ] || [ pnpm-lock.yaml -nt node_modules/.modules.yaml ]; then echo "→ lockfile moved, installing"; pnpm install --frozen-lockfile --silent; fi'

# Everything here is plain Node reading a checkout. What is missing is deliberate: the
# simulator, xcrun, native builds, EAS and signing all need the Mac, and Metro has to answer a
# device on the local network. The check:* scripts run in a loop rather than a chain of && so
# that adding one is a word, not another line continuation crossing the ssh boundary.
VPS_CHECK='pnpm --filter mobile exec tsc --noEmit && npx --yes oxlint apps/mobile && for c in i18n activity counter gamification goal preferences recap time-ruler; do echo "→ check:$c"; pnpm --filter mobile run "check:$c" || exit 1; done'
